RABBITMQ_HOST=rabbitmq   # имя хоста rabbitmq
RABBITMQ_PORT=5672       # порт
RABBITMQ_USER=user       # login
RABBITMQ_PASS=password   # password

RABBITMQ_REQUEST_QUEUE=request_queue
RABBITMQ_RESPONSE_QUEUE=response_queue
RABBITMQ_PREFETCH=7

QWEN_TEXT_MODEL=JEILDLWLRMA/Qwen3-VL-4B-Instruct-NVFP4
QWEN_TEXT_URL=http://qwen-vl:8000/v1/chat/completions
QWEN_PICT_MODEL=JEILDLWLRMA/Qwen3-VL-4B-Instruct-NVFP4
QWEN_PICT_URL=http://qwen-vl:8000/v1/chat/completions
LLM_TIMEOUT=55            # МЕНЬШЕ responseTimeout в PHP (там 60 с)
LLM_MAX_TOKENS=500
LLM_RETRIES=1

REDIS_URL=redis://redis:6379/2
REDIS_SOCKET_TIMEOUT=2
IMAGE_TTL=3600            # сколько живёт «последнее фото», сек
IMAGE_MAX_BYTES=10485760
IMAGE_MAX_SIDE=600
IMAGE_JPEG_QUALITY=75
IMAGE_FETCH_TIMEOUT=20

LOG_LEVEL=INFO
